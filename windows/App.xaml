<Application x:Class="Clothesline.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- 照片右键菜单，与托盘菜单同一套：米白圆角、悬停浅红、黛色字。 -->
        <SolidColorBrush x:Key="MenuPaper" Color="#F6F1E7" />
        <SolidColorBrush x:Key="MenuBorder" Color="#E0D7C6" />
        <SolidColorBrush x:Key="MenuInk" Color="#2E3440" />
        <SolidColorBrush x:Key="MenuHover" Color="#EFDDD6" />
        <SolidColorBrush x:Key="MenuRule" Color="#E3DAC8" />

        <Style TargetType="ContextMenu">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource MenuInk}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="0,0,10,10" Padding="4,6" CornerRadius="10"
                                Background="{StaticResource MenuPaper}"
                                BorderBrush="{StaticResource MenuBorder}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Opacity="0.22" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" MinWidth="168" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource MenuInk}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" CornerRadius="6" Padding="14,7,18,7" Background="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource MenuHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B8B1A4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="10,5" Background="{StaticResource MenuRule}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
